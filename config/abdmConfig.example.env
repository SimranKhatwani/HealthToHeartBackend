# ==============================================================================
# ABDM (Ayushman Bharat Digital Mission) Sandbox Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real credentials or secrets to version control.
# - Keep all credentials server-side; NEVER expose these values to the browser.
# - Fill in these values in your local .env file once your ABDM Sandbox registration
#   is approved by the National Health Authority (NHA).
# ==============================================================================

# ABDM Gateway Base URL
# Sandbox default: https://dev.abdm.gov.in
# Production URL will be provided upon milestone-3 (M3) production clearance.
ABDM_GATEWAY_URL=https://dev.abdm.gov.in

# Client ID provided in the ABDM Developer Portal upon sandbox approval
ABDM_CLIENT_ID=your_abdm_sandbox_client_id_here

# Client Secret provided in the ABDM Developer Portal upon sandbox approval
# CRITICAL: Keep this secret strictly private. Never expose in logs or client-side code.
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret_here

# Consent Manager ID / Header
# Sandbox default: sbx
ABDM_X_CM_ID=sbx

# HTTP Request Timeout for ABDM Gateway API calls (in milliseconds)
# Recommended: 15000 (15 seconds)
ABDM_REQUEST_TIMEOUT_MS=15000

# Ephemeral ABHA Verification Session Expiry (in seconds)
# Used by the MongoDB TTL index on AbhaVerificationSession collection.
# Default: 900 (15 minutes)
ABDM_SESSION_TTL_SECONDS=900
